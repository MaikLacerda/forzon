rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    match /accounts/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validState() && request.resource.data.revision == 1;
      allow update: if owns(uid) && validState() && request.resource.data.revision == resource.data.revision + 1;
      function validState() {
        return request.resource.data.keys().hasOnly(['revision', 'chunkCount', 'updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 20
          && request.resource.data.updatedAt == request.time;
      }
      match /chunks/{index} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && index.matches('([0-9]|1[0-9])')
          && request.resource.data.keys().hasOnly(['text', 'revision'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 240000
          && request.resource.data.revision == getAfter(/databases/$(database)/documents/accounts/$(uid)).data.revision
          && getAfter(/databases/$(database)/documents/accounts/$(uid)).data.updatedAt == request.time;
        allow delete: if owns(uid);
      }
    }
    // Everything outside these private account paths stays closed.
    match /{document=**} { allow read, write: if false; }
  }
}
